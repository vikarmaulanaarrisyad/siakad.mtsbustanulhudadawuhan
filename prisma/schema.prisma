generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma2"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  BENDAHARA
  KEPSEK
  KESISWAAN
  GURU
  SISWA
  ORTU
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SISWA)
  
  homeroomClasses ClassRoom[] @relation("HomeroomTeacher")
  classId       String?
  classRoom     ClassRoom?    @relation("ClassStudents", fields: [classId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String // e.g., "2023/2024"
  semester    String // "Ganjil" or "Genap"
  startDate        DateTime
  registrationDate DateTime? // Masa Registrasi Ulang
  midtermDate      DateTime? // Tanggal Ujian Tengah Semester
  endDate     DateTime
  status    String   @default("Draf") // "Draf", "Aktif", "Selesai"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes   ClassRoom[]

  @@unique([name, semester])
}

model ClassRoom {
  id             String       @id @default(cuid())
  name           String       // Contoh: "VII-A"
  level          String       // Contoh: "Kelas VII"
  capacity       Int          @default(32) // Maksimal kapasitas
  color          String?      // Indikator warna di UI, misal "bg-green-600"
  
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  
  homeroomId     String?      // ID Wali Kelas
  homeroom       User?        @relation("HomeroomTeacher", fields: [homeroomId], references: [id])
  
  students       User[]       @relation("ClassStudents")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
