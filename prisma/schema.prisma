generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma2"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  BENDAHARA
  KEPSEK
  KESISWAAN
  GURU
  SISWA
  ORTU
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SISWA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String // e.g., "2023/2024"
  semester    String // "Ganjil" or "Genap"
  startDate        DateTime
  registrationDate DateTime? // Masa Registrasi Ulang
  midtermDate      DateTime? // Tanggal Ujian Tengah Semester
  endDate     DateTime
  status    String   @default("Draf") // "Draf", "Aktif", "Selesai"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, semester])
}
