generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  BENDAHARA
  KEPSEK
  KESISWAAN
  GURU
  SISWA
  ORTU
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SISWA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
